# Copy this file to .env and edit values if needed.
# Comma-separated allowed frontend origins. No trailing slash.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173,https://murthy-bunny.github.io

# Optional persistent database location. Defaults to backend/portfolio.db
# DATABASE_PATH=C:/data/portfolio.db

# If set, PostgreSQL is used instead of SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Brevo SMTP notifications (use a verified sender and an SMTP key).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your-brevo-smtp-login
# SMTP_PASSWORD=your-brevo-smtp-key
# MAIL_FROM=your-verified-sender@example.com
# MAIL_TO=kothagundlamurthy@gmail.com
